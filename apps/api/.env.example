NODE_ENV=development
PORT=3001

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/seti

# Redis connection string
REDIS_URL=redis://localhost:6379

# Pretium (offramp provider)
PRETIUM_API_URL=https://api.pretium.io
PRETIUM_API_KEY=your_pretium_api_key

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=seti-dev-token
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# Blockchain settlement defaults
SETTLEMENT_CHAIN=celo
SETTLEMENT_ASSET=USDC
